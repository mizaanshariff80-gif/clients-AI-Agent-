# ─── Required ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
PORT=3001

# ─── Email (Gmail) ────────────────────────────────────────────────────────────
# Powers appointment confirmations, review-request emails, owner alerts,
# and Sales Rep outreach. Use a Gmail App Password, not your login password.
EMAIL_USER=you@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME=Your Business

# ─── Google reviews: read + reply (Business Profile API) ──────────────────────
# Full control — the agent can publish replies to Google.
# Setup: Google Cloud project → enable "My Business Account Management" and
# "My Business Business Information" APIs → OAuth consent → get a refresh token
# for scope https://www.googleapis.com/auth/business.manage
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCOUNT_ID=
GOOGLE_LOCATION_ID=

# ─── Google reviews: read only (Places API) ───────────────────────────────────
# Simpler fallback — an API key reads up to 5 reviews, but cannot post replies.
# Set the Place ID in the dashboard: Front Desk → Settings → Business profile.
GOOGLE_PLACES_API_KEY=

# ─── Sales Rep lead sourcing ──────────────────────────────────────────────────
APOLLO_API_KEY=
