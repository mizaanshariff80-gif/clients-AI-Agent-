# Fill these in and rename this file to `.env`

# Anthropic (Claude) - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (ChatGPT) - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Moonshot (Kimi) - https://platform.moonshot.cn/console/api-keys
# For international users: https://platform.moonshot.ai/
MOONSHOT_API_KEY=sk-...
# Set to https://api.moonshot.ai/v1 for international, or https://api.moonshot.cn/v1 for China
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Google Maps Platform - https://console.cloud.google.com/google/maps-apis
# Enable: Places API, Directions API, Geocoding API
GOOGLE_MAPS_API_KEY=AIza...

# Optional: model overrides
CLAUDE_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o
KIMI_MODEL=moonshot-v1-32k

# Optional: server config
HOST=0.0.0.0
PORT=8000
